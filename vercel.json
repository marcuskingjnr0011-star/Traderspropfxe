{
  "rewrites": [
    {"source":"/v1/payments/pesapal/checkout","destination":"/checkout"},
    {"source":"/v1/payments/pesapal/status","destination":"/status"},
    {"source":"/api/pesapal/callback","destination":"/callback"},
    {"source":"/api/pesapal/ipn","destination":"/ipn"}
